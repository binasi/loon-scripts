#!date=2024-01-01

[Script]
# Cookie获取 - 使用宽泛匹配以确保能捕获到
http-request ^https:\/\/7m9gi9norz\.1095813\.xyz script-path=https://raw.githubusercontent.com/binasi/loon-scripts/main/get-cookie.js, requires-body=false, timeout=10, tag=获取机场Cookie, enable=true

# 定时签到 - 每天早上8点
cron "0 8 * * *" script-path=https://raw.githubusercontent.com/binasi/loon-scripts/main/checkin.js, timeout=60, tag=机场每日签到, enable=true

[MITM]
hostname = 7m9gi9norz.1095813.xyz
