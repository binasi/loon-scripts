#!name=机场自动签到
#!desc=自动获取Cookie并每日签到
#!author=binas

[Script]
# Cookie获取 - 修改为你的机场域名
http-request ^https?:\/\/7m9gi9norz.1095813.xyz\.com script-path=https://raw.githubusercontent.com/binasi/loon-scripts/main/checkin.js, requires-body=false, timeout=10, tag=获取机场Cookie, enable=true

# 定时签到
cron "0 8 * * *" script-path=https://raw.githubusercontent.com/binasi/loon-scripts/main/checkin.js, timeout=60, tag=机场每日签到, enable=true

[MITM]
hostname = 7m9gi9norz.1095813.xyz
