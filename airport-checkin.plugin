#!name=机场自动签到
#!desc=自动获取Cookie并每日签到
#!author=你的名字
#!homepage=https://github.com/binasi/loon-scripts
#!icon=https://raw.githubusercontent.com/binasi/loon-scripts/main/icon.png
#!date=2024-01-01

[Script]
# 获取Cookie
http-request ^https?:\/\/your-airport\.com\/user script-path=https://raw.githubusercontent.com/binasi/loon-scripts/main/checkin.js, requires-body=false, timeout=10, tag=获取机场Cookie

# 定时签到
cron "0 8 * * *" script-path=https://raw.githubusercontent.com/binasi/loon-scripts/main/checkin.js, timeout=60, tag=机场每日签到

[MITM]
hostname = 7m9gi9norz.1095813.xyz
